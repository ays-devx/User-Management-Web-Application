<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit username</title>
</head>
<body>
    <form method="post" action="/user/<%=users.id%>?_method=PATCH">
    <h2>You are about to edit this user:<%=users.email%></h2>
    <textarea name="username"><%=users.username%></textarea><br><br>
    <input type="password" name="password" placeholder="enter password">
    <button>edit</button>
    </form>
</body>
</html>