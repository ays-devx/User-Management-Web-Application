<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show users</title>
</head>
<body>
    <h1>The users are</h1>
    <table border="1">
        <tr>
            <th>id</th>
            <th>username</th>
            <th>email</th>
            <th>password</th>
        </tr>
<% for (let user of result) { %>
    <tr>
        <td><%= user.id %></td>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td><%= user.password %></td>
        <td><form method="get" action="/users/<%=user.id%>/edit">
            <button> Edit username</button>
        </form></td>
    </tr>
<% } %>

    </table>
</body>
</html>